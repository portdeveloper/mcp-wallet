# Public local service URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Create a sandbox environment at https://app.dynamic.xyz
DYNAMIC_ENVIRONMENT_ID=

# Monad testnet
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Local PostgreSQL. Docker Compose supplies this value to containers.
DATABASE_URL=postgresql://mcp_wallet:mcp_wallet@localhost:5432/mcp_wallet

# Replace with a long random value outside local development.
TOKEN_PEPPER=local-development-only-change-me
